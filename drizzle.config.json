function ThemeToggle() {
  const { resolvedTheme, setTheme } = useTheme();
  const [mounted, setMounted] = useState(false);
  useEffect(() => setMounted(true), []);

  return (
    <button
      type="button"
      aria-label="Toggle dark mode"
      onClick={() => setTheme(resolvedTheme === "dark" ? "light" : "dark")}
      className="flex h-10 w-10 items-center justify-center rounded-full border border-slate-900/10 bg-white/60 text-slate-600 transition-all hover:border-royal/50 hover:text-royal dark:border-white/10 dark:bg-white/5 dark:text-white/70 dark:hover:border-royal/60 dark:hover:text-white"
    >
      {mounted ? (
        resolvedTheme === "dark" ? (
          <Sun className="h-[18px] w-[18px]" />
        ) : (
          <Moon className="h-[18px] w-[18px]" />
        )
      ) : (
        <span className="h-[18px] w-[18px]" />
      )}
    </button>
  );
}

function Logo() {
  return (
    <Link href="#home" className="group flex shrink-0 items-center gap-3" aria-label="SI Technician — Home">
      <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-royal to-royal-deep shadow-[0_10px_30px_-8px_rgba(46,98,255,0.8)] transition-transform duration-500 group-hover:rotate-6 group-hover:scale-105">
        <ShieldCheck className="h-[22px] w-[22px] text-white" strokeWidth={2.2} />
      </span>
      <span className="flex flex-col leading-none">
        <span className="text-[15px] font-bold tracking-tight text-slate-900 dark:text-white">
          SI <span className="text-gradient">Technician</span>
        </span>
        <span className="mt-1.5 text-[9px] font-semibold uppercase tracking-[0.2em] text-slate-400 dark:text-white/40">
          CCTV · RO Solutions
        </span>
      </span>
    </Link>
  );
}

export function Navbar() {
  const [scrolled, setScrolled] = useState(false);
  const [open, setOpen] = useState(false);

  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 30);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  useEffect(() => {
    document.body.style.overflow = open ? "hidden" : "";
    return () => {
      document.body.style.overflow = "";
    };
  }, [open]);

  return (
    <>
      <motion.header
        initial={{ y: -90, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        transition={{ duration: 0.9, ease: [0.22, 1, 0.36, 1] }}
        className="fixed inset-x-0 top-0 z-50 px-3 pt-3 md:px-6 md:pt-4"
      >
        <div
          className={`mx-auto flex max-w-7xl items-center justify-between gap-3 rounded-2xl px-4 transition-all duration-500 md:px-5 ${
            scrolled
              ? "glass-deep py-2.5 shadow-[0_20px_60px_-24px_rgba(2,6,23,0.65)]"
              : "glass py-3"
          }`}
        >
          <Logo />

          <nav className="hidden items-center gap-1 lg:flex" aria-label="Primary">
            {navLinks.map((link) => (
              <a
                key={link.href}
                href={link.href}
                className="group relative rounded-full px-3.5 py-2 text-[13px] font-medium text-slate-600 transition-colors hover:text-royal xl:px-4 dark:text-white/65 dark:hover:text-white"
              >
                {link.label}
                <span className="absolute inset-x-4 -bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full bg-royal transition-transform duration-300 group-hover:scale-x-100" />
              </a>
            ))}
          </nav>

          <div className="flex items-center gap-2.5">
            <ThemeToggle />
            <a
              href={`tel:${site.phoneTel}`}
              className="hidden items-center gap-2 rounded-full bg-royal px-5 py-2.5 text-[13px] font-semibold text-white transition-all hover:bg-royal-deep hover:shadow-[0_12px_36px_-10px_rgba(46,98,255,0.8)] md:inline-flex"
            >
              <Phone className="h-3.5 w-3.5" />
              {site.phoneDisplay}
            </a>
            <button
              type="button"
              aria-label="Open menu"
              onClick={() => setOpen(true)}
              className="flex h-10 w-10 items-center justify-center rounded-full border border-slate-900/10 bg-white/60 text-slate-700 transition hover:border-royal/50 hover:text-royal lg:hidden dark:border-white/10 dark:bg-white/5 dark:text-white/80"
            >
              <Menu className="h-[18px] w-[18px]" />
            </button>
          </div>
        </div>
      </motion.header>

      <AnimatePresence>
        {open && (
          <motion.div
            key="mobile-menu"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 z-[70] lg:hidden"
          >
            <div
              className="absolute inset-0 bg-ink/60 backdrop-blur-2xl dark:bg-ink/75"
              onClick={() => setOpen(false)}
            />
            <motion.nav
              initial={{ y: -32, opacity: 0, scale: 0.98 }}
              animate={{ y: 0, opacity: 1, scale: 1 }}
              exit={{ y: -24, opacity: 0, scale: 0.98 }}
              transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}
              className="glass-deep relative mx-3 mt-[92px] overflow-hidden rounded-3xl p-4"
              aria-label="Mobile"
            >
              <div className="mb-2 flex items-center justify-between px-2 pt-1">
                <span className="text-[10px] font-semibold uppercase tracking-[0.28em] text-royal dark:text-royal-soft">
                  Menu
                </span>
                <button
                  type="button"
                  aria-label="Close menu"
                  onClick={() => setOpen(false)}
                  className="flex h-9 w-9 items-center justify-center rounded-full border border-slate-900/10 text-slate-600 transition hover:text-royal dark:border-white/10 dark:text-white/70"
                >
                  <X className="h-4 w-4" />
                </button>
              </div>
              {navLinks.map((link, i) => (
                <motion.a
                  key={link.href}
                  href={link.href}
                  onClick={() => setOpen(false)}
                  initial={{ x: -18, opacity: 0 }}
                  animate={{ x: 0, opacity: 1 }}
                  transition={{ delay: 0.05 + i * 0.045 }}
                  className="flex items-center justify-between rounded-xl px-4 py-3.5 text-[15px] font-medium text-slate-800 transition-colors hover:bg-royal/10 hover:text-royal dark:text-white/85 dark:hover:text-white"
                >
                  {link.label}
                  <ArrowUpRight className="h-4 w-4 opacity-40" />
                </motion.a>
              ))}
              <div className="mt-3 grid grid-cols-2 gap-2.5 border-t border-slate-900/5 p-2 pt-4 dark:border-white/10">
                <a
                  href={`tel:${site.phoneTel}`}
                  className="inline-flex items-center justify-center gap-2 rounded-xl bg-royal py-3 text-sm font-semibold text-white"
                >
                  <Phone className="h-4 w-4" /> Call Now
                </a>
                <a
                  href={waLink("Hi SI Technician! I'd like to enquire about your products.")}
                  target="_blank"
                  rel="noreferrer"
                  className="inline-flex items-center justify-center gap-2 rounded-xl bg-[#25D366] py-3 text-sm font-semibold text-white"
                >
                  <WhatsAppIcon className="h-4 w-4" /> WhatsApp
                </a>
              </div>
            </motion.nav>
          </motion.div>
        )}
      </AnimatePresence>
    </>
  );
}

/* Floating WhatsApp / Call / Back-to-top cluster */
export function FloatingActions() {
  const [showTop, setShowTop] = useState(false);

  useEffect(() => {
    const onScroll = () => setShowTop(window.scrollY > 700);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  const tooltip =
    "pointer-events-none absolute right-full top-1/2 mr-3 hidden -translate-y-1/2 translate-x-2 whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-medium opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 glass-deep text-slate-700 dark:text-white/80 md:block";

  return (
    <div className="fixed bottom-5 right-5 z-[65] flex flex-col items-end gap-3">
      <AnimatePresence>
        {showTop && (
          <motion.button
            key="back-to-top"
            type="button"
            aria-label="Back to top"
            initial={{ opacity: 0, y: 14, scale: 0.85 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: 14, scale: 0.85 }}
            onClick={() => window.scrollTo({ top: 0, behavior: "smooth" })}
            className="group glass-deep relative flex h-11 w-11 items-center justify-center rounded-full text-slate-600 shadow-lg transition-colors hover:text-royal dark:text-white/75"
          >
            <ArrowUp className="h-[18px] w-[18px]" />
            <span className={tooltip}>Back to top</span>
          </motion.button>
        )}
      </AnimatePresence>

      <motion.a
        href={`tel:${site.phoneTel}`}
        aria-label={`Call ${site.name}`}
        whileHover={{ scale: 1.08 }}
        whileTap={{ scale: 0.92 }}
        className="group relative flex h-12 w-12 items-center justify-center rounded-full bg-royal text-white glow-royal"
      >
        <Phone className="h-5 w-5" />
        <span className={tooltip}>Call {site.phoneDisplay}</span>
      </motion.a>

      <motion.a
        href={waLink("Hi SI Technician! I'd like to enquire about your products and services.")}
        target="_blank"
        rel="noreferrer"
        aria-label="Chat on WhatsApp"
        whileHover={{ scale: 1.08 }}
        whileTap={{ scale: 0.92 }}
        className="group relative flex h-14 w-14 items-center justify-center"
      >
        <span className="absolute inset-0 animate-pulse-ring rounded-full bg-[#25D366]/50" />
        <span className="relative flex h-full w-full items-center justify-center rounded-full bg-gradient-to-br from-[#2fe673] to-[#1eb856] text-white shadow-[0_14px_44px_-10px_rgba(37,211,102,0.7)]">
          <WhatsAppIcon className="h-6 w-6" />
        </span>
        <span className={tooltip}>Chat on WhatsApp</span>
      </motion.a>
    </div>
  );
}
